{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dayview",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-04-15",
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "dayviewmedia.com",
			"custom_domain": true
		},
		{
			"pattern": "www.dayviewmedia.com",
			"custom_domain": true
		}
	]
}
